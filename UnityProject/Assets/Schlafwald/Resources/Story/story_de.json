      "lines": [
        {
          "id": "fino_i1",
          "text": "Hörst du das leise Gähnen?",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "fino_i2",
          "text": "Da vorne, in der warmen Höhle, sitzt Fino, der kleine Fuchs.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "fino_i3",
          "text": "Seine Ohren hängen schon ein bisschen. Er ist so müde.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "fino_p0",
          "text": "Fino friert ein kleines bisschen. Kannst du seine kuschelige Decke über ihn ziehen?",
          "phase": "step0",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "fino_h",
          "text": "Nimm die Decke mit deinem Finger … und zieh sie ganz sanft zu Fino.",
          "phase": "hint",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "fino_a",
          "text": "Ich helfe dir ein kleines bisschen. Schau, die Decke wandert ganz von allein.",
          "phase": "assist",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "fino_o1",
          "text": "Hach, wie warm.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "yawn"
        },
        {
          "id": "fino_o2",
          "text": "Fino rollt sich ganz klein zusammen.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "curlUp"
        },
        {
          "id": "fino_o3",
          "text": "Sein flauschiger Schwanz deckt die Nase zu.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "tailOverNose"
        },
        {
          "id": "fino_o4",
          "text": "Gute Nacht, kleiner Fino.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "soft",
          "cue": "sleep"
        }
      ],
