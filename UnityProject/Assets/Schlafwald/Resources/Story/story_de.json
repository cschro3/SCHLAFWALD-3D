      "lines": [
        {
          "id": "nuri_i1",
          "text": "Huch, was raschelt denn da?",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "nuri_i2",
          "text": "Das ist Nuri, das Eichhörnchen. Er sucht und sucht.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "nuri_i3",
          "text": "Sein liebstes Kuschelnüsschen ist weg.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "nuri_p0",
          "text": "Siehst du die kleine Eichel dort? Bringst du sie zu Nuri?",
          "phase": "step0",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "nuri_h",
          "text": "Nimm die Eichel und leg sie in Nuris Pfoten.",
          "phase": "hint",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "nuri_a",
          "text": "Die Eichel kullert ganz von allein zu Nuri. Wie schön.",
          "phase": "assist",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "nuri_o1",
          "text": "Nuri hält sie ganz fest.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "holdAcorn"
        },
        {
          "id": "nuri_o2",
          "text": "Er streckt sich und gähnt.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "stretchYawn"
        },
        {
          "id": "nuri_o3",
          "text": "Sein flauschiger Schwanz wird zur Decke.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "tailBlanket"
        },
        {
          "id": "nuri_o4",
          "text": "Gute Nacht, kleiner Nuri.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "soft",
          "cue": "sleep"
        }
      ],
