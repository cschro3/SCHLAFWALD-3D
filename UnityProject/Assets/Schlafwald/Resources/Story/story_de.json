    {
      "id": "ch9",
      "title": "Der ganze Wald schläft",
      "kind": "finale",
      "animalId": "",
      "lines": [
        {
          "id": "fin_01",
          "text": "Schau mal …",
          "phase": "",
          "pauseAfter": 2.0,
          "tone": "warm",
          "shotId": "overview"
        },
        {
          "id": "fin_fino",
          "text": "Fino schläft.",
          "phase": "",
          "pauseAfter": 1.4,
          "tone": "warm",
          "animalId": "fino",
          "shotId": "@fino.sleep"
        },
        {
          "id": "fin_mila",
          "text": "Mila träumt.",
          "phase": "",
          "pauseAfter": 1.4,
          "tone": "warm",
          "animalId": "mila",
          "shotId": "@mila.sleep"
        },
        {
          "id": "fin_piko",
          "text": "Piko liegt warm in seinen Blättern.",
          "phase": "",
          "pauseAfter": 1.4,
          "tone": "warm",
          "animalId": "piko",
          "shotId": "@piko.sleep"
        },
        {
          "id": "fin_luna",
          "text": "Luna hat ihre Augen geschlossen.",
          "phase": "",
          "pauseAfter": 1.4,
          "tone": "warm",
          "animalId": "luna",
          "shotId": "@luna.sleep"
        },
        {
          "id": "fin_nuri",
          "text": "Nuri kuschelt mit seiner kleinen Eichel.",
          "phase": "",
          "pauseAfter": 1.4,
          "tone": "warm",
          "animalId": "nuri",
          "shotId": "@nuri.sleep"
        },
        {
          "id": "fin_leni",
          "text": "Leni ruht ganz friedlich.",
          "phase": "",
          "pauseAfter": 1.4,
          "tone": "warm",
          "animalId": "leni",
          "shotId": "@leni.sleep"
        },
        {
          "id": "fin_suri",
          "text": "Und sogar die kleine Suri ist in ihrem Schneckenhaus eingeschlafen.",
          "phase": "",
          "pauseAfter": 2.0,
          "tone": "warm",
          "animalId": "suri",
          "shotId": "@suri.sleep"
        },
        {
          "id": "fin_02",
          "text": "Jetzt ist der ganze Wald still.",
          "phase": "",
          "pauseAfter": 1.8,
          "tone": "soft",
          "shotId": "moon"
        },
        {
          "id": "fin_03",
          "text": "Die Blätter rascheln nur noch ganz leise.",
          "phase": "",
          "pauseAfter": 1.8,
          "tone": "soft"
        },
        {
          "id": "fin_04",
          "text": "Der Mond passt auf alle auf.",
          "phase": "",
          "pauseAfter": 2.2,
          "tone": "soft"
        },
        {
          "id": "fin_05",
          "text": "Und vielleicht … ist es jetzt auch für dich Zeit, die Augen zu schließen.",
          "phase": "",
          "pauseAfter": 2.5,
          "tone": "whisper"
        },
        {
          "id": "fin_06",
          "text": "Gute Nacht, kleiner Schatz.",
          "phase": "",
          "pauseAfter": 2.5,
          "tone": "whisper"
        },
        {
          "id": "fin_07",
          "text": "Schlaf schön.",
          "phase": "",
          "pauseAfter": 4.0,
          "tone": "whisper"
        }
      ],
