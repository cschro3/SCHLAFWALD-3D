      "lines": [
        {
          "id": "luna_i1",
          "text": "Huhu … ganz leise, hoch oben auf dem Lieblingsast sitzt Luna, die kleine Eule.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "luna_i2",
          "text": "Ihre großen Augen sind noch hellwach.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "luna_p0",
          "text": "Die Glühwürmchen tanzen um sie herum. Kannst du sie ganz sanft berühren?",
          "phase": "step0",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "luna_h",
          "text": "Tippe die leuchtenden Glühwürmchen ganz vorsichtig an.",
          "phase": "hint",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "luna_a",
          "text": "Die Glühwürmchen werden von allein müde und leuchten leiser.",
          "phase": "assist",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "luna_o1",
          "text": "Das Licht wird weicher … und weicher.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "fluffFeathers"
        },
        {
          "id": "luna_o2",
          "text": "Luna blinzelt immer langsamer.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "slowBlink"
        },
        {
          "id": "luna_o3",
          "text": "Sie steckt den Kopf ins warme Gefieder.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "headInFeathers"
        },
        {
          "id": "luna_o4",
          "text": "Gute Nacht, kleine Luna.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "soft",
          "cue": "sleep"
        }
      ],
