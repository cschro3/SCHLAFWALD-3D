      "lines": [
        {
          "id": "suri_i1",
          "text": "Und wer kommt denn da so langsam angeschlichen?",
          "phase": "intro",
          "pauseAfter": 1.5,
          "tone": "warm"
        },
        {
          "id": "suri_i2",
          "text": "Ach, das ist Suri, unsere kleine Schnecke.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "suri_i3",
          "text": "Sie hat sich heute ganz viel Zeit genommen, um den Wald zu entdecken.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "feelersCurious"
        },
        {
          "id": "suri_i4",
          "text": "Jetzt ist sie aber schrecklich müde.",
          "phase": "intro",
          "pauseAfter": 1.6,
          "tone": "warm",
          "cue": "lookAtChild"
        },
        {
          "id": "suri_p0",
          "text": "Suri möchte zu ihrem Schlafplatz. Zeig ihr den Weg … ganz langsam, mit deinem Finger.",
          "phase": "step0",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "suri_h0",
          "text": "Lege deinen Finger auf das leuchtende Licht und gehe ganz langsam voran. Suri folgt dir.",
          "phase": "hint",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "suri_a0",
          "text": "Suri findet den Weg auch ganz allein. Sie ist ja eine kluge kleine Schnecke.",
          "phase": "assist",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "suri_s0",
          "text": "Da ist sie schon.",
          "phase": "success0",
          "pauseAfter": 1.0,
          "tone": "warm"
        },
        {
          "id": "suri_p1",
          "text": "Schau mal, ihr Schlafplatz braucht noch ein Blätterdach.",
          "phase": "step1",
          "pauseAfter": 1.0,
          "tone": "warm"
        },
        {
          "id": "suri_p1b",
          "text": "Kannst du ihr helfen?",
          "phase": "step1",
          "pauseAfter": 0.6,
          "tone": "warm"
        },
        {
          "id": "suri_h1",
          "text": "Nimm das große Blatt und leg es über den Stein.",
          "phase": "hint",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "suri_a1",
          "text": "Ich helfe dir ein kleines bisschen. Schau, das Blatt schwebt ganz sanft hinauf.",
          "phase": "assist",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "suri_s1",
          "text": "… Wie gemütlich!",
          "phase": "success1",
          "pauseAfter": 1.4,
          "tone": "warm"
        },
        {
          "id": "suri_p2",
          "text": "Berühre ganz sanft ihr Häuschen.",
          "phase": "step2",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "suri_h2",
          "text": "Du kannst ihr Häuschen ganz leicht berühren.",
          "phase": "hint",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "suri_a2",
          "text": "Das Häuschen freut sich auch so über dich.",
          "phase": "assist",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "suri_o1",
          "text": "Suri zieht ihre kleinen Fühler ein.",
          "phase": "outro",
          "pauseAfter": 1.8,
          "tone": "warm",
          "cue": "retractFeelers"
        },
        {
          "id": "suri_o2",
          "text": "Ganz langsam …",
          "phase": "outro",
          "pauseAfter": 2.0,
          "tone": "soft",
          "cue": "enterShell"
        },
        {
          "id": "suri_o3",
          "text": "Und noch ein kleines Stückchen …",
          "phase": "outro",
          "pauseAfter": 2.5,
          "tone": "soft",
          "cue": "enterShellDeep"
        },
        {
          "id": "suri_o4",
          "text": "Gute Nacht, kleine Suri.",
          "phase": "outro",
          "pauseAfter": 2.5,
          "tone": "whisper",
