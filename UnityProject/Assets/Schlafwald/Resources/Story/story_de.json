      "lines": [
        {
          "id": "piko_i1",
          "text": "Tapp, tapp, tapp … wer trippelt denn da?",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "piko_i2",
          "text": "Das ist Piko, der kleine Igel. Er möchte sein Nest für die Nacht bauen.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "piko_p0",
          "text": "Für ein weiches Bett braucht er drei Blätter. Schiebst du sie zu ihm?",
          "phase": "step0",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "piko_h",
          "text": "Schieb ein Blatt nach dem anderen zu Pikos Nest.",
          "phase": "hint",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "piko_a",
          "text": "Piko holt sich die Blätter jetzt selbst. Das macht er ganz geschickt.",
          "phase": "assist",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "piko_o1",
          "text": "Piko schiebt die Blätter mit der Nase zurecht.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "nudgeLeaf"
        },
        {
          "id": "piko_o2",
          "text": "Er kuschelt sich ein und rollt sich zusammen.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "curlBall"
        },
        {
          "id": "piko_o3",
          "text": "Hörst du? Er schnarcht ganz leise.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "snore"
        },
        {
          "id": "piko_o4",
          "text": "Gute Nacht, kleiner Piko.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "soft",
          "cue": "sleep"
        }
      ],
