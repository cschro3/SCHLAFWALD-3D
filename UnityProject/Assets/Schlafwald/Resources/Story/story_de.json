      "lines": [
        {
          "id": "mila_i1",
          "text": "Und wer sitzt da im weichen Moosnest?",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "mila_i2",
          "text": "Das ist Mila, das Kaninchen. Ihre langen Ohren lauschen noch.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "mila_p0",
          "text": "Mila mag es, wenn man sie streichelt. Magst du sie ganz sanft streicheln?",
          "phase": "step0",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "mila_h",
          "text": "Fahr mit dem Finger ganz langsam über ihr weiches Fell.",
          "phase": "hint",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "mila_a",
          "text": "Mila kuschelt sich auch so schon gemütlich ein.",
          "phase": "assist",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "mila_o1",
          "text": "Schau, ihre Ohren werden ganz schwer.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "earsDown"
        },
        {
          "id": "mila_o2",
          "text": "Sie blinzelt … und noch einmal …",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "blink"
        },
        {
          "id": "mila_o3",
          "text": "Gute Nacht, liebe Mila.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "soft",
          "cue": "sleep"
        }
      ],
