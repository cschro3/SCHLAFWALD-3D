      "lines": [
        {
          "id": "leni_i1",
          "text": "Im Mondlicht, auf einer weichen Lichtung, liegt Leni, das kleine Rehkitz.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "leni_i2",
          "text": "Sie schaut sich noch ein wenig um.",
          "phase": "intro",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "leni_p0",
          "text": "Streichelst du ihr ganz sanft über den Rücken?",
          "phase": "step0",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "leni_h0",
          "text": "Fahr mit dem Finger langsam über Lenis Rücken.",
          "phase": "hint",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "leni_a0",
          "text": "Leni kuschelt sich auch so schon hin.",
          "phase": "assist",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "leni_s0",
          "text": "Das tut gut.",
          "phase": "success0",
          "pauseAfter": 0.8,
          "tone": "warm"
        },
        {
          "id": "leni_p1",
          "text": "Und ein weiches Mooskissen für ihren Kopf? Schiebst du es unter?",
          "phase": "step1",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "leni_h1",
          "text": "Nimm das Mooskissen und schieb es unter Lenis Kopf.",
          "phase": "hint",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "leni_a1",
          "text": "Das Kissen schwebt ganz sanft zu Leni.",
          "phase": "assist",
          "pauseAfter": 1.2,
          "tone": "warm"
        },
        {
          "id": "leni_o1",
          "text": "Leni legt sich ganz hin.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "lieDown"
        },
        {
          "id": "leni_o2",
          "text": "Ihre Ohren werden weich.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "earsRelax"
        },
        {
          "id": "leni_o3",
          "text": "Ihre Augen werden schwer.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "warm",
          "cue": "heavyLids"
        },
        {
          "id": "leni_o4",
          "text": "Gute Nacht, liebe Leni.",
          "phase": "outro",
          "pauseAfter": 1.2,
          "tone": "soft",
          "cue": "sleep"
        }
      ],
