  "chapters": [
    {
      "id": "ch1",
      "title": "Der Abend kommt",
      "kind": "intro",
      "animalId": "",
      "lines": [
        {
          "id": "ch1_01",
          "text": "Guten Abend, kleiner Schatz.",
          "phase": "",
          "pauseAfter": 1.8,
          "tone": "warm",
          "shotId": "sunset"
        },
        {
          "id": "ch1_02",
          "text": "Die Sonne geht langsam schlafen. Sie malt den Himmel ganz sanft orange.",
          "phase": "",
          "pauseAfter": 1.6,
          "tone": "warm"
        },
        {
          "id": "ch1_03",
          "text": "Hörst du? Der Wind flüstert leise durch die Blätter.",
          "phase": "",
          "pauseAfter": 1.6,
          "tone": "warm",
          "shotId": "gate"
        },
        {
          "id": "ch1_04",
          "text": "Komm, wir gehen zusammen in den Schlafwald.",
          "phase": "",
          "pauseAfter": 1.8,
          "tone": "warm"
        },
        {
          "id": "ch1_05",
          "text": "Dort warten sieben kleine Freunde auf dich. Sie sind schon ein bisschen müde.",
          "phase": "",
          "pauseAfter": 1.5,
          "tone": "warm",
          "when": "all"
        },
        {
          "id": "ch1_05b",
          "text": "Dort wartet ein kleiner Freund auf dich. Er ist schon ein bisschen müde.",
          "phase": "",
          "pauseAfter": 1.5,
          "tone": "warm",
          "when": "partial"
        },
        {
          "id": "ch1_06",
          "text": "Wollen wir ihnen helfen, einzuschlafen?",
          "phase": "",
          "pauseAfter": 2.0,
          "tone": "warm",
          "when": "all"
        },
        {
          "id": "ch1_06b",
          "text": "Wollen wir ihm helfen, einzuschlafen?",
          "phase": "",
          "pauseAfter": 2.0,
          "tone": "warm",
          "when": "partial"
        }
      ],
