      "name": "Primary forest action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Warm entry action over the forest; the SVG arrow uses the shipped path.",
      "html": "<button class=\"ds-primary\">In den Schlafwald <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{font-family:Schlafwald,'Trebuchet MS',sans-serif;background:#ecd4ad;color:#29423b;min-height:52px;padding:14px 23px;display:inline-flex;align-items:center;justify-content:center;gap:20px;border:0;border-radius:27px;font-weight:800;font-size:15px;box-shadow:0 8px 22px rgba(16,35,32,.16);cursor:pointer}.ds-primary svg{width:21px;height:21px;flex:none}.ds-primary:hover{filter:brightness(1.05)}.ds-primary:active{transform:translateY(1px)}.ds-primary:focus-visible{outline:3px solid #a97947;outline-offset:4px}.ds-primary:disabled{opacity:.45;cursor:default}"
    },
