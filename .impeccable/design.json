      "css": ".ds-adult-primary{font-family:Schlafwald,'Trebuchet MS',sans-serif;background:#49654e;color:#fbf2de;min-height:52px;padding:14px 23px;display:inline-flex;align-items:center;justify-content:center;gap:20px;border:0;border-radius:27px;font-weight:800;font-size:14px;box-shadow:0 8px 22px rgba(16,35,32,.16);cursor:pointer}.ds-adult-primary svg{width:21px;height:21px;flex:none}.ds-adult-primary:hover{filter:brightness(1.05)}.ds-adult-primary:active{transform:translateY(1px)}.ds-adult-primary:focus-visible{outline:3px solid #a97947;outline-offset:4px}.ds-adult-primary:disabled{opacity:.45;cursor:default}"
    },
